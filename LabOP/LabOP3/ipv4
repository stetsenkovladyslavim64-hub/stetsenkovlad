function ipToInt(ip = "127.0.0.1") {
  return ip
    .split(".")
    .map(Number)
    .map((byte, index, array) => byte << (8 * (3 - index)))
    .reduce((sum, byte) => sum + byte, 0);
}

console.log(ipToInt());
console.log(ipToInt("10.0.0.1"));
console.log(ipToInt("192.168.1.10"));
console.log(ipToInt("0.0.0.0"));
